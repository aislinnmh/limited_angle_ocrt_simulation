saveas(f,[save_directory sample_id '_originalRIROI.png'])
signal = mean(roi,'all');
noise = std(roi2,0,'all');
RI = signal/noise;
RI_list = [RI_list RI];
signal_list = [signal_list signal];
noise_list = [noise_list noise];

%%
RI_data.RI = RI_list;
RI_data.signal = signal_list;
RI_data.noise = noise_list;

%% Plot
RILimitedRange = [];
RILimitedSampling = [];
for i = 1:length(RI_data.RI)
    if RI_data.intervals(i) == 6 
        n = round(RI_data.max_angles(i)/RI_data.intervals(i))*2+1;
        data = [RI_data.max_angles(i) RI_data.intervals(i) RI_data.RI(i) RI_data.signal(i) RI_data.noise(i) n];
        RILimitedRange = [RILimitedRange; data];
    end
    if RI_data.max_angles(i) == 90
        n = round(RI_data.max_angles(i)/RI_data.intervals(i))*2+1;
        data = [RI_data.max_angles(i) RI_data.intervals(i) RI_data.RI(i) RI_data.signal(i) RI_data.noise(i) n];
        RILimitedSampling = [RILimitedSampling; data];
    end
end
%%
f = figure('Position',[100 100 500 400]);
hold on
plot(RILimitedRange(1,1)*2,RILimitedRange(1,3),'*k','markersize',10,'linewidth',2);
plot(RILimitedRange(:,1)*2,RILimitedRange(:,3),'--','linewidth',2,'color',[0 0.5 0.8]);
plot(RILimitedRange(:,1)*2,RILimitedRange(:,3),'.k','linewidth',2,'markersize',20);
legend(['Fully Sampled OCRT'],'fontsize',14,'location','southeast')
hold off
ax = gca;
ax.FontSize = 18;
ylabel('Signal to Noise Ratio','fontsize',20,'fontweight','bold')
xlabel('Total Angular Sampling Range','fontsize',20,'fontweight','bold')
xticks([0 60 120 180 360])
title({'Effect of angular range on RI','given constant 6\circ interval'},'fontsize',16)

save_directory = ['c:/Users/DEL-AIProjects/Documents/GitHub/limited_angle_ocrt_local_saves/Results/' sample_id];
saveas(f,[save_directory '_limited_range_plot.png'])
%%

f = figure('Position',[100 100 500 400]);
hold on
plot(RILimitedSampling(:,2),RILimitedSampling(:,3),'--','linewidth',2,'color',[0.8 0.4 0.2]);
plot(RILimitedSampling(:,2),RILimitedSampling(:,3),'.k','linewidth',2,'markersize',20);
hold off
ax = gca;
ax.FontSize = 18;
set(gca,'xdir','reverse')

ylabel('Signal to Noise Ratio','fontsize',20,'fontweight','bold')
xlabel('Angular Sampling Interval','fontsize',20,'fontweight','bold')
