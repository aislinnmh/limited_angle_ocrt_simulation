save_directory = ['c:/Users/DEL-AIProjects/Documents/GitHub/limited_angle_ocrt_local_saves/saved_models_and_variables/'];

result = load([load_directory sample_id '_data.mat']);
bscan = squeeze(result.Bscans(4,:,:));
bscan = imresize(bscan,[1024 1024]);
[m n] = size(bscan);

bscan = rescale(bscan).';
bscan = imhistmatch(bscan,ref);

% x left-right, z up-down
bscan = imrotate(bscan,-90);

f = figure(1);
    imshow(bscan)
    colormap(flipud(gray))
      title('Choose Signal ROI')

  
 roi = drawrectangle;
 xmin = roi.Position(1);
 ymin = roi.Position(2);
 width = roi.Position(3);
 height = roi.Position(4);

 ymax = ymin + height;
 xmax = xmin + width;

 f = figure(1);
 title('Choose Background ROI')

 btemp = bscan;
 w = 1;
 roi = bscan(ymin:ymax,xmin:xmax);
 btemp(ymin-w:ymin+w,xmin-w:xmax+w) = 0;
 btemp(ymax-w:ymax+w,xmin-w:xmax+w) = 0;
 btemp(ymin-w:ymax+w,xmin-w:xmin+w) = 0;
 btemp(ymin-w:ymax+w,xmax-w:xmax+w) = 0;

roi2 = drawrectangle;
 xmin = roi2.Position(1);
