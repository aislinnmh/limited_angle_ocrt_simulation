 width = roi2.Position(3);
 height = roi2.Position(4);
  width2 = width;
 height2 = height;

 ymax = ymin + height;
 xmax = xmin + width;

 roi2 = bscan(ymin:ymax,xmin:xmax);
 btemp(ymin-w:ymin+w,xmin-w:xmax+w) = 0;
 btemp(ymax-w:ymax+w,xmin-w:xmax+w) = 0;
 btemp(ymin-w:ymax+w,xmin-w:xmin+w) = 0;
 btemp(ymin-w:ymax+w,xmax-w:xmax+w) = 0;


imshow(btemp)
colormap(flipud(gray))
title(['0\circ'],'fontsize',16)

saveas(f,[save_directory sample_id '_SNRROI.png'])

% Calculate SNR
signal = mean(roi,'all');
noise = std(roi2,0,'all');
snr = signal/noise;
snr_list = [snr_list snr];
signal_list = [signal_list signal];
noise_list = [noise_list noise];


ref = bscan;
