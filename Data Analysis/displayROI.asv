max_angles = [90,60, 30, 18, 90, 90];
intervals = [6,6, 6, 6, 18, 30];

sample_id = 'mouse_vas_deferens1';


%% Full result

save_directory = ['c:/Users/DEL-AIProjects/Documents/GitHub/limited_angle_ocrt_local_saves/saved_models_and_variables/']

result = load([save_directory sample_id '_result.mat']);
bscan = imrotate(result.recon,-90);

bscan = rescale(bscan);
% lowhigh = stretchlim(bscan,[0.001 0.999]);
% bscan = imadjust(bscan,lowhigh,[0 1]);

f = figure(1);
imshow(bscan)
colormap(flipud(gray))
 
% Choose ROI
 roi = drawrectangle;
 xmin = roi.Position(1)
 ymin = roi.Position(2)
 width = roi.Position(3)
 height = roi.Position(4)

 ymax = ymin + height;
 xmax = xmin + width;

 f = figure(2);
roi = bscan(ymin:ymax,xmin:xmax);
imshow(roi)
colormap(flipud(gray))
% [low high] = stretchlim(bscan,[0.23 0.998]);

title(['0\circ'],'fontsize',16)
saveas(f,[save_directory sample_id '_ROI.png'])
%%
for i = 1:length(max_angles)

max_angle = max_angles(i);
interval = intervals(i);

n_bscans = round(max_angle/interval)*2+1;
anglename = [num2str(max_angle) '-' num2str(interval) '-' num2str(max_angle)];

save_directory = ['c:/Users/DEL-AIProjects/Documents/GitHub/limited_angle_ocrt_local_saves/saved_models_and_variables/' anglename '/'];

result = load([save_directory sample_id '_result.mat']);
bscan = result.recon;

bscan = rescale(bscan);
bscan = imhistmatch(bscan,ref);

if i==1
    f = figure(2);
    imshow(bscan)
    colormap(flipud(gray))
     
    % Choose ROI
     roi = drawrectangle;
     xmin = roi.Position(1)
     ymin = roi.Position(2)
     width = roi.Position(3)
     height = roi.Position(4)

     ymax = ymin + height;
     xmax = xmin + width;
end 

f = figure(2);
roi = bscan(ymin:ymax,xmin:xmax);
imshow(roi)
colormap(flipud(gray))

title([num2str(max_angle) '\circ to -' num2str(max_angle) '\circ in ' num2str(interval) '\circ intervals'],'fontsize',16)
saveas(f,[save_directory sample_id '_ROI.png'])
[save_directory sample_id '_ROI.png']
end



%% Raw Bscan

load_directory = ['c:/Users/DEL-AIProjects/Documents/GitHub/limited_angle_ocrt_local_saves/Datasets/18-6-18/']
save_directory = ['c:/Users/DEL-AIProjects/Documents/GitHub/limited_angle_ocrt_local_saves/saved_models_and_variables/'];

result = load([load_directory sample_id '_data.mat']);
bscan = squeeze(result.Bscans(4,:,:));
bscan = imresize(bscan,[1024 1024]);
[m n] = size(bscan);

bscan = rescale(bscan);
bscan = imhistmatch(bscan,ref);

f = figure(2);
roi = bscan(ymin:ymax,xmin:xmax);
imshow(roi)
colormap(flipud(gray))
% [low high] = stretchlim(bscan,[0.23 0.998]);


title(['0\circ'],'fontsize',16)
saveas(f,[save_directory sample_id '_originalROI.png'])